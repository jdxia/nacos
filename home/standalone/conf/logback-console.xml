<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">

    <!-- Console 仅输出到控制台 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- 在 Windows 终端需要 Jansi 才能正确显示颜色；macOS/Linux 无需此设置也可显示 -->
        <withJansi>true</withJansi>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <!-- 彩色高亮规则：
                 - %highlight(...) 按日志级别自动着色（ERROR 红/加粗、WARN 红、INFO 蓝等）
                 - %cyan(...) 给线程/Logger等固定上青色，便于快速扫读
               -->
            <pattern>
                %magenta(%d{yyyy-MM-dd HH:mm:ss.SSS}) %green([%thread])
                %highlight(%-5level) %cyan(%logger{36}) - %msg%n
            </pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 根日志级别 DEBUG，仅绑定控制台 -->
    <root level="DEBUG">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- 如需定向提高/降低某些包的级别，可按需解注释
    <logger name="com.alibaba.nacos" level="DEBUG" additivity="false">
      <appender-ref ref="STDOUT"/>
    </logger>
    -->
</configuration>
